<Page
    x:Class="Unicaption.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar 48 (window drag strip; caption buttons from MainWindow on the right), logo 24 -->
        <Border Background="{ThemeResource UcSurfaceCard}" BorderBrush="{ThemeResource UcBorderSubtle}"
                BorderThickness="0,0,0,1" Padding="24,0">
            <Image Source="ms-appx:///Assets/icon128.png" Width="24" Height="24"
                   HorizontalAlignment="Left" AutomationProperties.Name="Unicaption" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border x:Name="Card" Style="{StaticResource UcPanel}" MaxWidth="400" Margin="16,32"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,40,36,34">
                <StackPanel>
                    <Image Source="ms-appx:///Assets/icon128.png" Width="56" Height="56" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Welcome to Unicaption" Style="{StaticResource UcText}" FontSize="24" FontWeight="ExtraBold"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock Text="Real-time transcription &amp; translation" Style="{StaticResource UcText}"
                               Foreground="{ThemeResource UcTextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" />

                    <!-- Trial banner: height 44, radius 8 -->
                    <Border Height="44" Margin="0,32,0,0" CornerRadius="8" Background="{ThemeResource UcBrandSurface}"
                            BorderBrush="{ThemeResource UcBrandBorder}" BorderThickness="1">
                        <TextBlock Text="60 minutes free on sign up · No credit card" Style="{StaticResource UcText}"
                                   FontSize="13" FontWeight="Bold" Foreground="{ThemeResource UcBrandHover}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Email + password (Firebase), same flows as the web app -->
                    <StackPanel x:Name="EmailForm" Margin="0,24,0,0" Spacing="10">
                        <TextBox x:Name="NameBox" Style="{StaticResource UcTextBox}" PlaceholderText="Full name"
                                 Visibility="Collapsed" KeyDown="OnFieldKeyDown" AutomationProperties.Name="Full name" />
                        <TextBox x:Name="EmailBox" Style="{StaticResource UcTextBox}" PlaceholderText="Email"
                                 InputScope="EmailSmtpAddress" KeyDown="OnFieldKeyDown" AutomationProperties.Name="Email" />
                        <PasswordBox x:Name="PasswordInput" PlaceholderText="Password" FontSize="14" CornerRadius="10"
                                     Padding="14,10" KeyDown="OnFieldKeyDown" AutomationProperties.Name="Password" />
                        <HyperlinkButton x:Name="ForgotLink" Content="Forgot password?" Style="{StaticResource UcLinkButton}"
                                         HorizontalAlignment="Right" Click="OnForgot" />
                        <Button x:Name="EmailButton" Style="{StaticResource UcPrimaryButton}" HorizontalAlignment="Stretch"
                                Click="OnEmailSubmit">
                            <TextBlock x:Name="EmailLabel" Text="Sign in" />
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ModePrompt" Text="New to Unicaption?" Style="{StaticResource UcMutedText}"
                                       VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="ModeLink" Content="Create account" Style="{StaticResource UcLinkButton}"
                                             FontWeight="SemiBold" Click="OnToggleMode" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Google is shown only when this build has a Desktop OAuth client -->
                    <Grid x:Name="OrDivider" Margin="0,18,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="1" Background="{ThemeResource UcBorderSubtle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="or" Style="{StaticResource UcMutedText}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Height="1" Background="{ThemeResource UcBorderSubtle}" VerticalAlignment="Center" />
                    </Grid>
                    <Button x:Name="GoogleButton" Style="{StaticResource UcSecondaryButton}" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Click="OnSignIn"
                            AutomationProperties.Name="Continue with Google">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontFamily="{StaticResource UcIcons}" FontSize="16" />
                            <TextBlock x:Name="GoogleLabel" Text="Continue with Google" />
                        </StackPanel>
                    </Button>
                    <HyperlinkButton x:Name="CancelLink" Content="Cancel" Visibility="Collapsed"
                                     HorizontalAlignment="Center" Margin="0,6,0,0" Click="OnCancel" />

                    <TextBlock x:Name="InfoText" Visibility="Collapsed" Style="{StaticResource UcText}" FontSize="12"
                               Foreground="{ThemeResource UcSuccess}" TextAlignment="Center" Margin="0,12,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Style="{StaticResource UcText}" FontSize="12"
                               Foreground="{ThemeResource UcError}" TextAlignment="Center" Margin="0,12,0,0"
                               AutomationProperties.LiveSetting="Assertive" />

                    <StackPanel x:Name="LegalPanel" Margin="0,24,0,0" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource UcMutedText}" TextAlignment="Center"
                                   Text="By signing in you agree to our" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <HyperlinkButton x:Name="TermsLink" Content="Terms" Style="{StaticResource UcLinkButton}" Click="OnTerms" />
                            <TextBlock x:Name="AndText" Text="and" Style="{StaticResource UcMutedText}" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="PrivacyLink" Content="Privacy Policy" Style="{StaticResource UcLinkButton}" Click="OnPrivacy" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
