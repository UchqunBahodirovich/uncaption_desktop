<Page
    x:Class="Unicaption.App.Views.PlaygroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unicaption.App.Controls"
    NavigationCacheMode="Required"
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Top bar (48) = window drag strip: logo + name toggles the sidebar; caption buttons
             are drawn by MainWindow at the right edge ═══ -->
        <Button x:Name="BrandButton" Style="{StaticResource UcButtonBase}" Margin="16,0,0,0" Padding="8,6"
                CornerRadius="10" HorizontalAlignment="Left" Click="OnToggleSidebar"
                ToolTipService.ToolTip="Toggle sidebar" AutomationProperties.Name="Toggle sidebar">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="ms-appx:///Assets/icon128.png" Width="26" Height="26" />
                <TextBlock Text="Unicaption" Style="{StaticResource UcText}" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar: 264 / 72, translucent nav surface; only the inner (right) corners are
                 rounded, the outer edge stays flush with the window in both widths ═══ -->
            <Border x:Name="Sidebar" Width="264" BorderBrush="{ThemeResource UcBorderSubtle}" BorderThickness="0,1,1,1"
                    CornerRadius="0,16,16,0">
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource UcBgStop1}" TintOpacity="0.55" FallbackColor="{ThemeResource UcBgStop1}" />
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Profile card: radius 14, avatar 44, progress 6. The avatar + name row opens the
                         account menu (text size, theme, support, log out). -->
                    <Border x:Name="ProfileCard" Margin="14,16,14,8" Padding="8,8,8,14" CornerRadius="14"
                            Background="{ThemeResource UcSurfaceNav}" BorderBrush="{ThemeResource UcBorderSubtle}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Button x:Name="AccountButton" Style="{StaticResource UcRowButton}" Padding="6" Margin="0"
                                    Click="OnAccountMenu" ToolTipService.ToolTip="Account menu"
                                    AutomationProperties.Name="Account menu">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="44" Height="44">
                                    <Ellipse Fill="{ThemeResource UcBrand}" />
                                    <TextBlock x:Name="AvatarText" FontSize="18" FontWeight="ExtraBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="NameText" Style="{StaticResource UcText}" FontSize="15" FontWeight="Bold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource UcBadge}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="PlanBadge" FontSize="10" FontWeight="ExtraBold" CharacterSpacing="50"
                                                   Foreground="{ThemeResource UcBrand}" />
                                    </Border>
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="{StaticResource UcIcons}" FontSize="12"
                                          Foreground="{ThemeResource UcTextMuted}" />
                            </Grid>
                            </Button>
                            <StackPanel Spacing="6" Padding="6,0,6,0">
                            <TextBlock x:Name="MinutesText" Style="{StaticResource UcSecondaryText}" FontSize="12" Margin="0,4,0,0" />
                            <ProgressBar x:Name="MinutesBar" Height="6" MinHeight="6" CornerRadius="3" Maximum="1"
                                         Background="{ThemeResource UcProgressTrack}" Foreground="{ThemeResource UcBrand}"
                                         AutomationProperties.Name="Minutes used" />
                            <HyperlinkButton x:Name="AccountRetry" Content="Retry" Visibility="Collapsed" Padding="0" FontSize="12" Click="OnAccountRetry" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Mini profile: avatar; plan and minutes left in its tooltip -->
                    <StackPanel x:Name="MiniProfile" Visibility="Collapsed" Margin="12,16,12,8" Spacing="6" HorizontalAlignment="Center">
                        <Button x:Name="MiniAvatar" Style="{StaticResource UcButtonBase}" Padding="0" CornerRadius="18"
                                Click="OnAccountMenu" AutomationProperties.Name="Account menu">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{ThemeResource UcBrand}" />
                                <TextBlock x:Name="MiniAvatarText" FontSize="15" FontWeight="ExtraBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Padding="12,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavStack">
                            <Button x:Name="ModelNav" Style="{StaticResource UcNavButton}" Click="OnModel" AutomationProperties.Name="Model">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE9E9;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="Model" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DomainNav" Style="{StaticResource UcNavButton}" Click="OnDomain" AutomationProperties.Name="Domain">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE80A;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="Domain" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="WorkspaceLabel" Text="WORKSPACE" Style="{StaticResource UcSectionLabel}" Margin="8,18,8,8" />
                            <Button x:Name="ContextNav" Style="{StaticResource UcNavButton}" Click="OnContext" AutomationProperties.Name="Context">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8A5;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="Context" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NotesNav" Style="{StaticResource UcNavButton}" Click="OnNotes" AutomationProperties.Name="Notes">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE70F;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="Notes" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DictionaryNav" Style="{StaticResource UcNavButton}" Click="OnDictionary" AutomationProperties.Name="Dictionary">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE82D;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="Dictionary" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="AudioLabel" Text="AUDIO" Style="{StaticResource UcSectionLabel}" Margin="8,18,8,8" />
                            <Button x:Name="MicNav" Tag="0" Style="{StaticResource UcNavButton}" Click="OnAudioSource" AutomationProperties.Name="Microphone">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE720;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="Mic" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SystemNav" Tag="1" Style="{StaticResource UcNavButton}" Click="OnAudioSource" AutomationProperties.Name="System audio">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE767;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="System" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BothNav" Tag="2" Style="{StaticResource UcNavButton}" Click="OnAudioSource" AutomationProperties.Name="Microphone and system audio">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE81E;" Style="{StaticResource UcIcon}" />
                                    <TextBlock Text="Both" Style="{StaticResource UcNavLabel}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ Workspace: two equal panels (gap 16), padding 16/16/16/8, Start below ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="16,16,16,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:TranscriptPanel x:Name="SourcePanel" />
                    <controls:TranscriptPanel x:Name="TranslationPanel" Grid.Column="1" />
                </Grid>

                <InfoBar x:Name="ErrorBar" Grid.Row="1" Margin="16,4,16,0" Severity="Error" IsOpen="False"
                         CloseButtonClick="OnErrorClosed" />

                <Button x:Name="StartButton" Grid.Row="2" Style="{StaticResource UcPillButton}" HorizontalAlignment="Center"
                        Margin="0,4,0,20" Click="OnStartStop">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="StartIcon" Glyph="&#xE720;" FontFamily="{StaticResource UcIcons}" FontSize="17" />
                        <ProgressRing x:Name="StartSpinner" IsActive="False" Visibility="Collapsed" Width="16" Height="16"
                                      MinWidth="16" MinHeight="16" Foreground="{ThemeResource UcOnBrand}"
                                      AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="StartLabel" Text="Start" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Screen-reader status (short session messages only, never per token) -->
        <TextBlock x:Name="StatusAnnouncer" Grid.Row="1" Opacity="0" IsHitTestVisible="False" Width="1" Height="1"
                   HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.LiveSetting="Assertive" />

        <!-- ═══ Overlays ═══
             Row 1 only: the top strip belongs to the window (drag + caption buttons), so panels
             and their close buttons never sit under Minimize / Maximize / Close. -->
        <controls:DictionaryPanel x:Name="Dictionary" Grid.Row="1" HorizontalAlignment="Right" Visibility="Collapsed" />
        <Canvas x:Name="NotesHost" Grid.Row="1" />
    </Grid>
</Page>
