<Page
    x:Class="Unicaption.App.Views.UsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unicaption.App.Controls"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </Page.KeyboardAccelerators>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- max-width 1200, outer padding 24, card gap 16 -->
        <StackPanel MaxWidth="1200" Padding="24" Spacing="16">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource UcIconButton}" Content="&#xE72B;" Click="OnBack"
                        ToolTipService.ToolTip="Back" AutomationProperties.Name="Back" />
                <TextBlock Grid.Column="1" Text="Usage &amp; Analytics" Style="{StaticResource UcPageTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Upgrade Plan" Style="{StaticResource UcPrimaryButton}" Click="OnUpgrade" />
            </Grid>

            <InfoBar x:Name="StateBar" IsClosable="False" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Click="OnRetry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource UcCard}">
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="CURRENT PLAN STATUS" Style="{StaticResource UcSectionLabel}" />
                        <TextBlock x:Name="PlanName" Style="{StaticResource UcText}" FontSize="24" FontWeight="ExtraBold" />
                        <TextBlock x:Name="PlanExpiry" Style="{StaticResource UcMutedText}" />
                    </StackPanel>
                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="24" Height="24" HorizontalAlignment="Right"
                                  AutomationProperties.Name="Loading account" />
                </Grid>
            </Border>

            <controls:ResponsiveGrid x:Name="UsageCards">
                <Border Style="{StaticResource UcCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Voice Time" Style="{StaticResource UcText}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Streaming transcription" Style="{StaticResource UcMutedText}" />
                        <TextBlock x:Name="VoiceValue" Style="{StaticResource UcText}" FontSize="20" FontWeight="ExtraBold" Margin="0,8,0,0" />
                        <ProgressBar x:Name="VoiceBar" Maximum="1" Height="6" MinHeight="6" CornerRadius="3"
                                     Background="{ThemeResource UcProgressTrack}" AutomationProperties.Name="Voice time used" />
                        <TextBlock x:Name="VoiceRemaining" Style="{StaticResource UcMutedText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource UcCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Translations" Style="{StaticResource UcText}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="AI Multilingual processing" Style="{StaticResource UcMutedText}" />
                        <TextBlock x:Name="TranslationsValue" Style="{StaticResource UcText}" FontSize="20" FontWeight="ExtraBold" Margin="0,8,0,0" />
                        <ProgressBar x:Name="TranslationsBar" Maximum="1" Height="6" MinHeight="6" CornerRadius="3"
                                     Background="{ThemeResource UcProgressTrack}" AutomationProperties.Name="Translations used" />
                        <TextBlock x:Name="TranslationsRemaining" Style="{StaticResource UcMutedText}" />
                    </StackPanel>
                </Border>
            </controls:ResponsiveGrid>

            <Border x:Name="OnDemandCard" Style="{StaticResource UcCard}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="ON-DEMAND BALANCE" Style="{StaticResource UcSectionLabel}" />
                    <TextBlock x:Name="OnDemandBalance" Style="{StaticResource UcText}" FontSize="24" FontWeight="ExtraBold" />
                    <TextBlock x:Name="OnDemandDetail" Style="{StaticResource UcSecondaryText}" />
                    <ProgressBar x:Name="OnDemandBar" Maximum="1" Height="6" MinHeight="6" CornerRadius="3"
                                 Background="{ThemeResource UcProgressTrack}" AutomationProperties.Name="On-demand balance used" />
                </StackPanel>
            </Border>

            <TextBlock Text="Activity Metrics" Style="{StaticResource UcText}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" />
            <controls:ResponsiveGrid x:Name="MetricCards">
                <Border Style="{StaticResource UcCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SessionsValue" Style="{StaticResource UcText}" FontSize="28" FontWeight="ExtraBold" />
                        <TextBlock Text="SESSIONS" Style="{StaticResource UcSectionLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource UcCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="MinutesValue" Style="{StaticResource UcText}" FontSize="28" FontWeight="ExtraBold" />
                        <TextBlock Text="TOTAL MINUTES" Style="{StaticResource UcSectionLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource UcCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="StreakValue" Style="{StaticResource UcText}" FontSize="28" FontWeight="ExtraBold" />
                        <TextBlock Text="ACTIVE STREAK" Style="{StaticResource UcSectionLabel}" />
                    </StackPanel>
                </Border>
            </controls:ResponsiveGrid>

            <!-- ACCOUNT 01: no history endpoint yet → honest "Coming soon", not a fake empty list -->
            <TextBlock Text="Session History" Style="{StaticResource UcText}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" />
            <Border Style="{StaticResource UcCard}" Padding="32">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE81C;" FontFamily="{StaticResource UcIcons}" FontSize="28" Foreground="{ThemeResource UcTextMuted}" />
                    <TextBlock Text="Coming soon" Style="{StaticResource UcText}" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Session history will appear here once it is available for your account." Style="{StaticResource UcMutedText}" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
