<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Motion ═════════════════════════════════════════════════════════════
         Strong ease-out (Exponential 6 ≈ cubic-bezier(0.23, 1, 0.32, 1)) everywhere. Press feedback
         scales to 0.97 in 100 ms and releases in 160 ms; panels 150–220 ms (Controls/Motion.cs). -->

    <!-- ═══ Buttons ════════════════════════════════════════════════════════════
         Every clickable element has default / hover / pressed / focused / disabled
         states (UI 04). Focus uses the system focus ring (always visible on keyboard). -->

    <ControlTemplate x:Key="UcOverlayButtonTemplate" TargetType="Button">
        <Grid x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <Border x:Name="Overlay" Background="{ThemeResource UcTextPrimary}" Opacity="0"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Presenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <!-- Leaving Pressed eases the scale back instead of snapping to 1. -->
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.16">
                            <VisualTransition.GeneratedEasingFunction>
                                <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Opacity" Value="0.06" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                             To="0.97" Duration="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                             To="0.97" Duration="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <VisualState.Setters>
                            <Setter Target="Overlay.Opacity" Value="0.12" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Disabled only dims: swapping the background would hide content whose colours
                         are set per state (e.g. a filled, selected nav item while a session runs). -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="UcBrandButtonTemplate" TargetType="Button">
        <Grid x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <ContentPresenter x:Name="Presenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <!-- Leaving Pressed eases the scale back instead of snapping to 1. -->
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.16">
                            <VisualTransition.GeneratedEasingFunction>
                                <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource UcBrandHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                             To="0.97" Duration="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                             To="0.97" Duration="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource UcBrandHover}" />
                            <Setter Target="Root.Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Brand stays brand while busy ("Connecting…"), just quieter. -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="UcButtonBase" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="{StaticResource UcFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template" Value="{StaticResource UcOverlayButtonTemplate}" />
    </Style>

    <!-- AppButton: min height 40, radius 8, padding 14, 13/600 -->
    <Style x:Key="UcPrimaryButton" TargetType="Button" BasedOn="{StaticResource UcButtonBase}">
        <Setter Property="Background" Value="{ThemeResource UcBrand}" />
        <Setter Property="Foreground" Value="{ThemeResource UcOnBrand}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource UcBrandButtonTemplate}" />
    </Style>

    <Style x:Key="UcSecondaryButton" TargetType="Button" BasedOn="{StaticResource UcButtonBase}">
        <Setter Property="Background" Value="{ThemeResource UcSurfaceSubtle}" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextSecondary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UcBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="UcDangerButton" TargetType="Button" BasedOn="{StaticResource UcPrimaryButton}">
        <Setter Property="Background" Value="{ThemeResource UcError}" />
    </Style>

    <!-- Start / Stop: rounded rectangle (radius 12), padding 28×12, 15/700 -->
    <Style x:Key="UcPillButton" TargetType="Button" BasedOn="{StaticResource UcPrimaryButton}">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="28,12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <!-- 28×28 visual icon buttons get a 32×32 hit area (UI 05). Tooltip + AutomationName set per use. -->
    <Style x:Key="UcIconButton" TargetType="Button" BasedOn="{StaticResource UcButtonBase}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UcIcons}" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- ═══ Window caption buttons (custom title bar) ═══════════════════════════
         40×32, radius 8, 10px glyphs like the system ones. Close turns red on hover. -->
    <Style x:Key="UcCaptionButton" TargetType="Button" BasedOn="{StaticResource UcIconButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource UcSystemIcons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextSecondary}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <ControlTemplate x:Key="UcCloseCaptionTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter x:Name="Presenter"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource UcError}" />
                            <Setter Target="Presenter.Foreground" Value="White" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource UcError}" />
                            <Setter Target="Root.Opacity" Value="0.8" />
                            <Setter Target="Presenter.Foreground" Value="White" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="UcCloseCaptionButton" TargetType="Button" BasedOn="{StaticResource UcCaptionButton}">
        <Setter Property="Template" Value="{StaticResource UcCloseCaptionTemplate}" />
    </Style>

    <!-- Sidebar nav item: radius 10, vertical padding 11 -->
    <Style x:Key="UcNavButton" TargetType="Button" BasedOn="{StaticResource UcButtonBase}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Language pill: height 32, radius 8, padding 10, 13/600 -->
    <Style x:Key="UcLanguagePill" TargetType="Button" BasedOn="{StaticResource UcButtonBase}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{ThemeResource UcSurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UcBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- List row inside popups (model / domain / text size / languages) -->
    <Style x:Key="UcRowButton" TargetType="Button" BasedOn="{StaticResource UcButtonBase}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="UcChipButton" TargetType="Button" BasedOn="{StaticResource UcButtonBase}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource UcSurfaceCard}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UcBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="UcPrimaryChipButton" TargetType="Button" BasedOn="{StaticResource UcChipButton}">
        <Setter Property="Background" Value="{ThemeResource UcBrandSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UcBrandBorder}" />
        <Setter Property="Foreground" Value="{ThemeResource UcBrand}" />
    </Style>

    <Style x:Key="UcLinkButton" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource UcTextSecondary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ═══ Surfaces ══════════════════════════════════════════════════════════ -->

    <!-- Panel: radius 16, border 1 (shadow applied via ThemeShadow in code) -->
    <Style x:Key="UcPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource UcSurfaceCard}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UcBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="UcCard" TargetType="Border" BasedOn="{StaticResource UcPanel}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="UcFlyoutPresenter" TargetType="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Icon tile used by every dialog and tour step header -->
    <Style x:Key="UcIconTile" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource UcBrandSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UcBrandBorder}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="UcTileIcon" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource UcIcons}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource UcBrand}" />
    </Style>

    <!-- Text badges are rounded rectangles (radius 6), never pills. -->
    <Style x:Key="UcBadge" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource UcBrandSurface}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ Text ══════════════════════════════════════════════════════════════ -->

    <Style x:Key="UcText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UcFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="UcSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource UcText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextSecondary}" />
    </Style>

    <Style x:Key="UcMutedText" TargetType="TextBlock" BasedOn="{StaticResource UcText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextMuted}" />
    </Style>

    <!-- Section label 11/800, letter spacing 0.8 -->
    <Style x:Key="UcSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource UcText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="73" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextMuted}" />
    </Style>

    <Style x:Key="UcPanelTitle" TargetType="TextBlock" BasedOn="{StaticResource UcText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Large text gets slightly negative tracking (-0.015em); body text stays at 0. -->
    <Style x:Key="UcDialogTitle" TargetType="TextBlock" BasedOn="{StaticResource UcText}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style x:Key="UcPageTitle" TargetType="TextBlock" BasedOn="{StaticResource UcText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="-15" />
    </Style>

    <!-- Sidebar label 14/500 -->
    <Style x:Key="UcNavLabel" TargetType="TextBlock" BasedOn="{StaticResource UcText}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="UcIcon" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource UcIcons}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{ThemeResource UcTextSecondary}" />
    </Style>

    <!-- ═══ Inputs ════════════════════════════════════════════════════════════ -->

    <Style x:Key="UcTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UcFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- Multi-line boxes scroll internally; extra right padding keeps text off the scrollbar. -->
    <Style x:Key="UcMultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource UcTextBox}">
        <Setter Property="Padding" Value="14,10,24,10" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
