<Window
    x:Class="Unicaption.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Unicaption">

    <Grid x:Name="Root">
        <!-- Ambient background (section 13): gradient + orange top glow + bottom glow -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="{ThemeResource UcBgStop0}" />
                    <GradientStop Offset="0.5" Color="{ThemeResource UcBgStop1}" />
                    <GradientStop Offset="1" Color="{ThemeResource UcBgStop2}" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="300" Height="300" Margin="-70,-90,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{ThemeResource UcGlowTop}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="360" Height="360" Margin="0,0,100,-120"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{ThemeResource UcGlowBottom}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Frame x:Name="RootFrame" />

        <!-- Custom title bar: the system caption is removed (MainWindow.SetupTitleBar). The top
             48 px of every page is the drag region; these buttons sit at its right edge. -->
        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" Spacing="2" Margin="0,8,10,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource UcCaptionButton}" Content="&#xE921;" Click="OnMinimize"
                    ToolTipService.ToolTip="Minimize" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource UcCaptionButton}" Content="&#xE922;" Click="OnMaximize"
                    ToolTipService.ToolTip="Maximize" AutomationProperties.Name="Maximize" />
            <Button Style="{StaticResource UcCloseCaptionButton}" Content="&#xE8BB;" Click="OnCloseClick"
                    ToolTipService.ToolTip="Close" AutomationProperties.Name="Close" />
        </StackPanel>
    </Grid>
</Window>
