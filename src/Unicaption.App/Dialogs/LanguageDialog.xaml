<ContentDialog
    x:Class="Unicaption.App.Dialogs.LanguageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unicaption.App.Dialogs"
    xmlns:controls="using:Unicaption.App.Controls"
    Style="{StaticResource UcDialogStyle}"
    PrimaryButtonText="Confirm"
    CloseButtonText="Cancel">

    <ContentDialog.Title>
        <controls:DialogHeader x:Name="Header" Glyph="&#xE894;" />
    </ContentDialog.Title>

    <!-- Language dialog 460 × 600. Transcription: first pick = primary, further picks = hints.
         Translation: a single target language. -->
    <Grid Width="412" Height="460" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Current selection as removable chips -->
        <Grid MinHeight="32">
            <controls:WrapPanel x:Name="SelectionChips" Spacing="6" VerticalAlignment="Center" />
            <TextBlock x:Name="EmptySelection" Style="{StaticResource UcMutedText}" VerticalAlignment="Center"
                       Text="Pick the main spoken language first" Visibility="Collapsed" />
        </Grid>

        <TextBox x:Name="Search" Grid.Row="1" Style="{StaticResource UcTextBox}" PlaceholderText="Search languages..."
                 TextChanged="OnSearchChanged" AutomationProperties.Name="Search languages" />

        <Grid Grid.Row="2">
            <TextBlock Text="ALL LANGUAGES" Style="{StaticResource UcSectionLabel}" />
            <TextBlock x:Name="LimitText" Style="{StaticResource UcMutedText}" HorizontalAlignment="Right"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <ListView x:Name="LanguageList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" AutomationProperties.Name="Languages">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LanguageItem">
                    <!-- Right gutter keeps the trailing tag clear of the overlay scrollbar. -->
                    <Grid ColumnSpacing="12" Padding="0,6,18,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource UcSurfaceRaised}">
                            <TextBlock Text="{x:Bind Badge}" FontSize="11" FontWeight="ExtraBold"
                                       Foreground="{ThemeResource UcTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource UcTextPrimary}" />
                            <TextBlock Text="{x:Bind Code}" FontSize="12" Foreground="{ThemeResource UcTextMuted}" />
                        </StackPanel>

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Border Style="{StaticResource UcBadge}" Visibility="{x:Bind PrimaryVisibility, Mode=OneWay}">
                                <TextBlock Text="PRIMARY" FontSize="10" FontWeight="ExtraBold" CharacterSpacing="50"
                                           Foreground="{ThemeResource UcBrand}" />
                            </Border>
                            <Border Style="{StaticResource UcBadge}" Background="{ThemeResource UcSurfaceRaised}"
                                    Visibility="{x:Bind HintVisibility, Mode=OneWay}">
                                <TextBlock Text="HINT" FontSize="10" FontWeight="ExtraBold" CharacterSpacing="50"
                                           Foreground="{ThemeResource UcTextSecondary}" />
                            </Border>
                            <Grid Width="20" Height="20" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}">
                                <Ellipse Fill="{ThemeResource UcBrand}" />
                                <FontIcon Glyph="&#xE5CA;" FontFamily="{StaticResource UcIcons}" FontSize="10"
                                          Foreground="{ThemeResource UcOnBrand}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
