<ContentDialog
    x:Class="Unicaption.App.Dialogs.ContextDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Unicaption.App.Controls"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="18">

    <!-- Context dialog: width 520, padding 24, inner scroll -->
    <ScrollViewer Width="472" MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Padding="0,0,8,0">
            <TextBlock Text="Context" Style="{StaticResource UcText}" FontSize="22" FontWeight="ExtraBold" />
            <TextBlock Text="Context helps captioning recognise domain-specific terms." Style="{StaticResource UcSecondaryText}" />

            <Grid Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Custom Context" Style="{StaticResource UcText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource UcBadge}">
                        <TextBlock x:Name="DomainBadge" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource UcBrand}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource UcMutedText}" FontSize="13" />
            </Grid>
            <TextBox x:Name="ContextBox" Style="{StaticResource UcTextBox}" MaxLength="300" Height="104"
                     AcceptsReturn="True" TextWrapping="Wrap" TextChanged="OnContextChanged"
                     PlaceholderText="Prilosec, Celebrex, Xanax, cardiology, stents..."
                     AutomationProperties.Name="Custom context" />

            <TextBlock x:Name="SuggestedLabel" Style="{StaticResource UcSectionLabel}" Margin="0,10,0,0" />
            <controls:WrapPanel x:Name="Chips" Spacing="8" />

            <Border Height="1" Background="{ThemeResource UcBorderSubtle}" Margin="0,14" />

            <TextBlock Text="Default Translation Prompt" Style="{StaticResource UcText}" FontSize="15" FontWeight="Bold" />
            <TextBox x:Name="PromptBox" Style="{StaticResource UcTextBox}" Height="104" AcceptsReturn="True"
                     TextWrapping="Wrap" AutomationProperties.Name="Default translation prompt" />
            <TextBlock Text="Prepended to translation instructions. Leave empty for default." Style="{StaticResource UcSecondaryText}" FontSize="12" />

            <Border CornerRadius="8" Padding="12,8" Margin="0,6,0,0" Background="{ThemeResource UcSurfaceSubtle}">
                <TextBlock Style="{StaticResource UcMutedText}"
                           Text="Saved on this device. Sending context and prompt to the transcription engine is enabled once the backend contract is confirmed." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
