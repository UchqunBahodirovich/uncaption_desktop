<UserControl
    x:Class="Unicaption.App.Controls.NotesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="320" Height="380">

    <!-- Notes: 320×380, header 48, footer 36, radius 14 -->
    <Border x:Name="Card" Background="{ThemeResource UcSurfaceCard}" BorderBrush="{ThemeResource UcBorderSubtle}"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Padding="12,0" Background="Transparent"
                  BorderBrush="{ThemeResource UcBorderSubtle}" BorderThickness="0,0,0,1"
                  PointerPressed="OnHeaderPressed" PointerMoved="OnHeaderMoved"
                  PointerReleased="OnHeaderReleased" PointerCaptureLost="OnHeaderReleased">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE25D;" FontFamily="{StaticResource UcIcons}" FontSize="14" Foreground="{ThemeResource UcTextMuted}" />
                    <FontIcon Glyph="&#xE745;" FontFamily="{StaticResource UcIcons}" FontSize="16" Foreground="{ThemeResource UcBrand}" />
                    <TextBlock Text="Notepad" Style="{StaticResource UcText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                    <Button Style="{StaticResource UcIconButton}" Content="&#xE14D;" Click="OnCopy"
                            ToolTipService.ToolTip="Copy" AutomationProperties.Name="Copy notes" />
                    <Button Style="{StaticResource UcIconButton}" Content="&#xE872;" Click="OnClear"
                            ToolTipService.ToolTip="Clear" AutomationProperties.Name="Clear notes" />
                    <Button Style="{StaticResource UcIconButton}" Content="&#xE5CD;" Click="OnClose"
                            ToolTipService.ToolTip="Close" AutomationProperties.Name="Close notes" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                     PlaceholderText="Type your notes here..." BorderThickness="0" CornerRadius="0"
                     Background="Transparent" Padding="16,16,24,16" FontSize="14"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged"
                     AutomationProperties.Name="Notes" />

            <Grid Grid.Row="2" Padding="14,0,4,0" BorderBrush="{ThemeResource UcBorderSubtle}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="CountText" Text="0 chars · 0 words" Style="{StaticResource UcMutedText}" VerticalAlignment="Center" />
                <TextBlock x:Name="CopiedText" Text="Copied" Visibility="Collapsed" Style="{StaticResource UcMutedText}"
                           Foreground="{ThemeResource UcSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <Border x:Name="ResizeGrip" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent"
                        PointerPressed="OnGripPressed" PointerMoved="OnGripMoved"
                        PointerReleased="OnGripReleased" PointerCaptureLost="OnGripReleased"
                        ToolTipService.ToolTip="Resize">
                    <FontIcon Glyph="&#xF1CE;" FontFamily="{StaticResource UcIcons}" FontSize="12"
                              Foreground="{ThemeResource UcTextMuted}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
